REDIS_URL=redis://localhost:6379/0
MQTT_BROKER=tcp://localhost:1883

# Object storage holding hosted feeds' uploaded zips. Read by
# railroad_club.object_store, not by this repo's Settings, so the names are
# railroad-club's. Point S3_ENDPOINT anywhere that speaks S3; the dev stack
# runs Garage.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=gtfs-feeds
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_REGION=garage
